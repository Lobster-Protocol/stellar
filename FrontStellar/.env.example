# Network configuration
# Set to 'mainnet' or 'testnet' to switch between networks
VITE_NETWORK=testnet

# Optional: Override RPC URL (defaults based on VITE_NETWORK)
# VITE_FACTORY_RPC=https://soroban-testnet.stellar.org

# Optional: Override Factory Contract ID (defaults based on VITE_NETWORK)
# VITE_FACTORY_CONTRACT=

# Optional: Override Network Passphrase (defaults based on VITE_NETWORK)
# VITE_FACTORY_NETWORK=
