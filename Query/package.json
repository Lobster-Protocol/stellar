{
  "name": "query",
  "version": "0.0.1",
  "description": "This project can be use as a starting point for developing your new Stellar Soroban SubQuery project",
  "main": "dist/index.js",
  "scripts": {
    "build": "subql codegen && subql build",
    "codegen": "subql codegen",
    "start:docker": "docker compose pull && docker compose up --remove-orphans",
    "dev": "subql codegen && subql build && docker compose pull && docker compose up --remove-orphans",
    "prepack": "rm -rf dist && npm run build",
    "test": "subql build && subql-node-stellar test",
    "build:develop": "NODE_ENV=develop subql codegen && NODE_ENV=develop subql build"
  },
  "homepage": "https://github.com/subquery/stellar-subql-starter",
  "repository": "github:subquery/stellar-subql-starter",
  "files": [
    "dist",
    "schema.graphql",
    "project.yaml"
  ],
  "author": "esteban",
  "license": "MIT",
  "dependencies": {
    "@subql/common": "latest",
    "@subql/node-stellar": "^6.0.2",
    "@subql/query": "^2.23.3",
    "@subql/types-stellar": "^5.0.1",
    "@subql/utils": "^2.21.1",
    "nats": "^2.29.3",
    "node-fetch": "^3.3.2",
    "stellar-base": "^11.0.0",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@subql/cli": "latest",
    "@subql/testing": "latest",
    "@subql/types": "latest",
    "@types/text-encoding": "^0.0.40",
    "dotenv": "latest",
    "typescript": "latest"
  }
}
