# Read by dotenv and by docker --env-file, which takes each line literally: KEY=value, no spaces around =, no quotes.

SECRET=
# testnet or mainnet
NETWORK=testnet

# Only read by multisig/signerApi.ts: one signer's ed25519 seed as 64 hex characters
SIGNER_SECRET_HEX=

# Core signer + network settings
FEEPAYER_SECRET=
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RPC_URL=https://soroban-testnet.stellar.org

# Multisig mode selector
MULTISIG_MODE=external
MULTISIG_TYPE=n-of-n
# Optional local signer keys (comma separated S-keys or 64-char hex seeds)
#MULTISIG_SIGNER_SECRETS=<signer 1 key>,<signer 2 key>

# Remote signer endpoints (each should run the signerApi container)
MULTISIG_SIGNER_APIS=http://localhost:4001,http://localhost:4002,http://localhost:4003

#Multisig address
CALLER_ADDRESS=CBX5O4ZTTZQRU2BSIR7MP56I7Y6NX2BXEAQBOM7TH32KJYU7UTN5JCOH

# Router the vaults were created with
SOROSWAP_ROUTER=CCKGGR3WQT3DJX7AW5YZLYBW5TP2HK6WSRLI4TFXVLSOALW4EBWWZ6Z4
PROCESS_URL=http://localhost:8085/data/last
# key for the Soroswap price API (api.soroswap.finance)
API_KEY=
PORT=3334
FACTORY_ID=CBFKFXFUDF3T3HFKTNDWTLCTQ7X5OEED2R6OKXXV5VEQIUW3PB7HPBX3

# One signer container per key. Export that signer's seed as SIGNER_SECRET_HEX in your shell first, so it stays out of this file:
# docker run --rm -p 127.0.0.1:4001:4001 -e SIGNER_SECRET_HEX -e SIGNER_API_PORT=4001 decisiontaker-signer
