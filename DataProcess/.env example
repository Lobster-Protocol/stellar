# DataProcess Environment Variables
# Copy this file to .env and update values as needed

# =============================================================================
# API Configuration
# =============================================================================

# Port for the Express API server
PORT=8085

# =============================================================================
# Network Configuration
# =============================================================================

# Network environment: 'testnet' or 'mainnet'
# This determines which pool_repertory files to load
NETWORK=testnet

# =============================================================================
# SubQuery Configuration
# =============================================================================

# SubQuery GraphQL endpoint URL
# Default: http://localhost:3000 (local Docker)
# For production, use your deployed SubQuery endpoint
SUBQUERY_URL=http://localhost:3000

# =============================================================================
# S3 Storage Configuration (MinIO)
# =============================================================================

# S3-compatible storage endpoint
# For local MinIO: http://127.0.0.1:9000
# For Docker: http://minio:9000
# For AWS S3: https://s3.amazonaws.com
S3_ENDPOINT=http://127.0.0.1:9000

# S3 region (required for AWS S3, optional for MinIO)
S3_REGION=us-east-1

# S3 access key ID
# For local MinIO: use the MINIO_ROOT_USER value
# For AWS: use your AWS Access Key ID
S3_ACCESS_KEY=lobster

# S3 secret access key
# For local MinIO: use the MINIO_ROOT_PASSWORD value
# For AWS: use your AWS Secret Access Key
S3_SECRET_KEY=lobster-secret-123

# S3 bucket name where processed metrics are stored
S3_BUCKET=lobster

# Allow overwriting existing objects in S3
# Set to '1' or 'true' to enable, '0' or 'false' to disable
S3_OVERWRITE=1

# =============================================================================
# Processing Configuration
# =============================================================================

# Pool polling interval in milliseconds (for poolsPoller.ts)
# Default: 12 hours (43200000 ms)
# Example: 6 hours = 21600000, 24 hours = 86400000
POOL_POLL_INTERVAL_MS=43200000

# =============================================================================
# Docker Compose Overrides
# =============================================================================
# When running in Docker, these values are typically set in docker-compose.yml
# Uncomment and adjust if running outside Docker:

# SUBQUERY_URL=http://host.docker.internal:3000
# S3_ENDPOINT=http://minio:9000

# =============================================================================
# Production/Deployment Notes
# =============================================================================
# 
# For production deployments:
# 1. Set NETWORK=mainnet
# 2. Update SUBQUERY_URL to your production SubQuery endpoint
# 3. Update S3_* variables for your production S3/MinIO instance
# 4. Use secure credentials (never commit .env to version control)
# 5. Consider using secrets management (AWS Secrets Manager, etc.)
#
# =============================================================================
